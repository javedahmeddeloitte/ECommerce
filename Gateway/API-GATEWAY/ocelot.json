{
  "Routes": [
    {
      "DownstreamPathTemplate": "/api/orders/order",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/orders/changeStatus/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders/change-status/{id}",
      "UpstreamHttpMethod": [ "PUT" ]
    },

    {
      "DownstreamPathTemplate": "/api/orders/placeOrder",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders/place",
      "UpstreamHttpMethod": [ "POST" ]
    },

    {
      "DownstreamPathTemplate": "/api/orders/cancelOrder/{id}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders/cancel/{id}",
      "UpstreamHttpMethod": [ "PUT" ]
    },

    {
      "DownstreamPathTemplate": "/api/orders/OrderByUser/{userId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders/user/{userId}",
      "UpstreamHttpMethod": [ "GET" ]
    },

    {
      "DownstreamPathTemplate": "/api/orders/OrderByOrderId/{orderId}",
      "DownstreamScheme": "https",
      "DownstreamHostAndPorts": [
        {
          "Host": "localhost",
          "Port": 44317
        }
      ],
      "UpstreamPathTemplate": "/gateway/orders/{orderId}",
      "UpstreamHttpMethod": [ "GET" ]
    }
  ],

  "GlobalConfiguration": {
    "BaseUrl": "https://localhost:44302"
  }
}
