{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "orders-route": {
        "ClusterId": "orders-cluster",
        "Match": {
          "Path": "/orders-gateway/{**catch-all}"
        },
        "Transforms": [
          { "PathPattern": "{**catch-all}" }
        ]
      },
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog-gateway/{**catch-all}" },
        "Transforms": [
          { "PathRemovePrefix": "/catalog-gateway" }
        ]
      }
    },
    "Clusters": {
      "orders-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "orders-destination-1": {
            "Address": "https://localhost:44317/"
          }
        }
      },

      "catalog-cluster": {
        "HttpClient": {
          "DangerousAcceptAnyServerCertificate": true
        },
        "Destinations": {
          "catalog-destination-1": { "Address": "https://localhost:44300/" }
        }
      }
    }
  }
}
